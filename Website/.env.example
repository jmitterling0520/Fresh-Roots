# Resend: contact form / agreement / SOW email notifications
# Get API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where to send each form / contract submission (your email)
CONTACT_FORM_TO_EMAIL=james.mitterling@icloud.com

# Optional: "From" address (must be verified in Resend or use onboarding@resend.dev for testing)
# After verifying freshrootsconsulting.us in Resend, use: contact@freshrootsconsulting.us
# CONTACT_FORM_FROM_EMAIL=Fresh Roots <contact@freshrootsconsulting.us>

# Vercel Blob: agreement + SOW submissions and view magic links (production + local)
# Create a Blob store in Vercel → Storage → Blob, then copy the read-write token.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
# Optional: store id from the Blob dashboard (token is usually enough for the SDK)
# CONTRACT_BLOB_STORE_ID=store_xxxxxxxxxxxx
