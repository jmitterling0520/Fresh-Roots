# Resend: contact form email notifications (production / Vercel)
# Get API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Where to send each form submission (your email)
CONTACT_FORM_TO_EMAIL=james.mitterling@icloud.com

# Optional: "From" address (must be verified in Resend or use onboarding@resend.dev for testing)
# After verifying freshrootsconsulting.us in Resend, use: contact@freshrootsconsulting.us
# CONTACT_FORM_FROM_EMAIL=Fresh Roots <contact@freshrootsconsulting.us>

# Vercel KV / Upstash Redis: agreement submissions + magic links (production)
# Get from Vercel: Project → Storage → your KV database → .env tab (or Connect to Project)
# Or from Upstash: Redis dashboard → REST API
KV_REST_API_URL=https://xxxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxx
